  "protocols": {
    "redis": {
      "status": "supported",
      "client_auth": "AUTH <session-token> / AUTH <user> <session-token>, terminated by the proxy",
      "upstream_auth": [
        "AUTH password (requirepass)",
        "AUTH user password (Redis 6+ ACL)"
      ],
      "forwarding": "RESP2/RESP3 messages forwarded verbatim; re-AUTH rewrites the password slot to the real secret",
      "unsupported": [
        "client-side and upstream TLS",
        "cluster redirection routing"
      ]
    },
    "mysql": {
      "status": "supported",
      "client_auth": "caching_sha2_password full authentication; session token arrives over client-side TLS or RSA-encrypted",
      "upstream_auth": [
        "mysql_native_password",
        "caching_sha2_password (fast path + full auth via RSA public key)"
      ],
      "forwarding": "binary relay after authentication; result sets, ERR and COM_QUIT untouched",
      "unsupported": [
        "upstream TLS",
        "COM_CHANGE_USER re-authentication",
        "result-set rewriting"
      ]
    },
    "mongo": {
      "status": "supported",
      "client_auth": "SASL PLAIN (mongosh --authenticationMechanism PLAIN, authSource=$external)",
      "upstream_auth": [
        "SCRAM-SHA-256 (full client implementation with server signature verification)"
      ],
      "forwarding": "OP_MSG relay after authentication; legacy OP_QUERY handshake answered with OP_REPLY",
      "unsupported": [
        "client-side SCRAM-SHA-256/SCRAM-SHA-1 termination: the proxy does not hold the token plaintext, so it cannot verify the client proof; faking it would accept any password, so SCRAM is rejected explicitly instead",
        "OP_COMPRESSED, client TLS, X.509 client certificates"
      ],
      "not_implemented": [
        "client-side SCRAM-SHA-256"
      ]
    }
  },
